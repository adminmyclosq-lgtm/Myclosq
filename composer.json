{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "gutreset/gutreset",
  "type": "project",
  "description": "Gut Reset — Laravel 13 ecommerce, guided 30-day reset and WhatsApp workflow platform.",
  "keywords": ["laravel", "gut-reset", "ecommerce", "whatsapp"],
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "laravel/boost": "^2.0",
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "classmap": [
      "database/seeders"
    ]
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "php artisan serve",
      "npm run dev"
    ],
    "test": [
      "@php artisan test"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  }
}
