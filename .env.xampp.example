APP_NAME="Gut Reset"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gutreset.local
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=gut_reset
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=gutreset.local,localhost,127.0.0.1

# External integrations are intentionally blank for local UI/functional testing.
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

GUTRESET_DAILY_WORKFLOW_TIME=09:00
GUTRESET_SHIPMENT_PROVIDER=manual
GUTRESET_AUTO_CREATE_SHIPMENT=true
SHIPMENT_WEBHOOK_SECRET=
